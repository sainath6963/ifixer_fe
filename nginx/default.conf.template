server {
  listen 8080;
  listen [::]:8080;
  server_name _;
  server_tokens off;

  root /usr/share/nginx/html;
  index index.html;
  # Allow a 25 MiB image plus multipart request overhead.
  client_max_body_size 28m;

  gzip on;
  gzip_min_length 1024;
  gzip_types application/javascript application/json image/svg+xml text/css text/plain;

  location /api/ {
    proxy_pass http://${BACKEND_ORIGIN};
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_connect_timeout 5s;
    proxy_read_timeout 60s;
  }

  location = /index.html {
    limit_except GET { deny all; }
    add_header Cache-Control "no-store";
    include /etc/nginx/snippets/rich-culture-security-headers.conf;
  }

  location /assets/ {
    limit_except GET { deny all; }
    try_files $uri =404;
    add_header Cache-Control "public, max-age=31536000, immutable";
    include /etc/nginx/snippets/rich-culture-security-headers.conf;
  }

  location / {
    limit_except GET { deny all; }
    try_files $uri $uri/ /index.html;
    include /etc/nginx/snippets/rich-culture-security-headers.conf;
  }
}
